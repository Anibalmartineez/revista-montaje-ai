{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revista-montaje-ai.local/schemas/editor-offset/layout-v2.schema.json",
  "title": "Editor Offset Visual Layout V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layout_schema_version",
    "job",
    "coordinate_system",
    "sheet",
    "faces",
    "assets",
    "works",
    "slots",
    "imposition",
    "export",
    "ctp"
  ],
  "properties": {
    "layout_schema_version": {
      "const": 2
    },
    "job": {
      "$ref": "#/$defs/job"
    },
    "coordinate_system": {
      "$ref": "#/$defs/coordinateSystem"
    },
    "sheet": {
      "$ref": "#/$defs/sheet"
    },
    "faces": {
      "$ref": "#/$defs/faces"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "imposition": {
      "$ref": "#/$defs/imposition"
    },
    "export": {
      "$ref": "#/$defs/export"
    },
    "ctp": {
      "$ref": "#/$defs/ctp"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "finiteNumber": {
      "type": "number"
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "$ref": "#/$defs/positiveNumber"
        },
        "height": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "$ref": "#/$defs/finiteNumber"
        },
        "y": {
          "$ref": "#/$defs/finiteNumber"
        },
        "width": {
          "$ref": "#/$defs/positiveNumber"
        },
        "height": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "nullableRect": {
      "oneOf": [
        {
          "$ref": "#/$defs/rect"
        },
        {
          "type": "null"
        }
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "revision", "created_at", "updated_at"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "updated_at": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "origin",
        "x_axis",
        "y_axis",
        "rotation_direction",
        "rotation_origin"
      ],
      "properties": {
        "unit": {
          "const": "mm"
        },
        "origin": {
          "const": "bottom_left"
        },
        "x_axis": {
          "const": "right"
        },
        "y_axis": {
          "const": "up"
        },
        "rotation_direction": {
          "const": "counter_clockwise"
        },
        "rotation_origin": {
          "const": "trim_center"
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_mm", "printable_margins_mm"],
      "properties": {
        "size_mm": {
          "$ref": "#/$defs/size"
        },
        "printable_margins_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right", "bottom", "top"],
          "properties": {
            "left": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "right": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "bottom": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "top": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        },
        "background": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color"],
          "properties": {
            "color": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "faces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "duplex"],
      "properties": {
        "enabled": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["front", "back"]
          }
        },
        "duplex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "flip"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "flip": {
              "enum": ["none", "long_edge", "short_edge"]
            }
          }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "page", "pdf_box"],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pdf_box": {
          "enum": ["media", "trim", "bleed", "crop"]
        }
      }
    },
    "preflightIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message"],
      "properties": {
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "level": {
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "color_spaces",
        "minimum_effective_dpi",
        "has_transparency",
        "has_overprint",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": ["not_run", "pass", "warning", "error"]
        },
        "color_spaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "minimum_effective_dpi": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_transparency": {
          "type": ["boolean", "null"]
        },
        "has_overprint": {
          "type": ["boolean", "null"]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflightIssue"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "intrinsic_rotation_deg", "boxes_mm", "preview_key", "preflight"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "intrinsic_rotation_deg": {
          "enum": [0, 90, 180, 270]
        },
        "boxes_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["media", "trim", "bleed", "crop"],
          "properties": {
            "media": {
              "$ref": "#/$defs/rect"
            },
            "trim": {
              "$ref": "#/$defs/nullableRect"
            },
            "bleed": {
              "$ref": "#/$defs/nullableRect"
            },
            "crop": {
              "$ref": "#/$defs/nullableRect"
            }
          }
        },
        "preview_key": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "preflight": {
          "$ref": "#/$defs/preflight"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original_filename",
        "storage_key",
        "mime_type",
        "sha256",
        "page_count",
        "status",
        "created_at",
        "pages"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "original_filename": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "storage_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mime_type": {
          "const": "application/pdf"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": ["uploaded", "processing", "ready", "error"]
        },
        "created_at": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "trim_size_mm",
        "bleed_mm",
        "requested_forms",
        "allowed_rotations_deg",
        "priority",
        "preferred_zone",
        "preferred_flow",
        "front_source",
        "back_source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "trim_size_mm": {
          "$ref": "#/$defs/size"
        },
        "bleed_mm": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "requested_forms": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_rotations_deg": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "preferred_zone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "preferred_flow": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "front_source": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "back_source": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "contentTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit_mode",
        "scale_x",
        "scale_y",
        "offset_mm",
        "rotation_deg",
        "mirror_x",
        "mirror_y",
        "clip_to"
      ],
      "properties": {
        "fit_mode": {
          "enum": ["actual_size", "contain", "cover", "stretch"]
        },
        "scale_x": {
          "$ref": "#/$defs/positiveNumber"
        },
        "scale_y": {
          "$ref": "#/$defs/positiveNumber"
        },
        "offset_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {
              "$ref": "#/$defs/finiteNumber"
            },
            "y": {
              "$ref": "#/$defs/finiteNumber"
            }
          }
        },
        "rotation_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "mirror_x": {
          "type": "boolean"
        },
        "mirror_y": {
          "type": "boolean"
        },
        "clip_to": {
          "enum": ["none", "trim_box", "bleed_box"]
        }
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "content", "production", "delete"],
      "properties": {
        "geometry": {
          "$ref": "#/$defs/lockSources"
        },
        "content": {
          "$ref": "#/$defs/lockSources"
        },
        "production": {
          "$ref": "#/$defs/lockSources"
        },
        "delete": {
          "$ref": "#/$defs/lockSources"
        }
      }
    },
    "lockSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["user", "ctp", "engine", "system"]
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "face",
        "work_id",
        "source",
        "geometry",
        "content_transform",
        "locks",
        "production",
        "generated_by"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "face": {
          "enum": ["front", "back"]
        },
        "work_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position_mm", "trim_size_mm", "bleed_mm", "rotation_deg"],
          "properties": {
            "position_mm": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x_mm", "y_mm", "anchor"],
              "properties": {
                "x_mm": {
                  "$ref": "#/$defs/finiteNumber"
                },
                "y_mm": {
                  "$ref": "#/$defs/finiteNumber"
                },
                "anchor": {
                  "const": "trim_center"
                }
              }
            },
            "trim_size_mm": {
              "$ref": "#/$defs/size"
            },
            "bleed_mm": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "rotation_deg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            }
          }
        },
        "content_transform": {
          "$ref": "#/$defs/contentTransform"
        },
        "locks": {
          "$ref": "#/$defs/locks"
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marks_profile_id"],
          "properties": {
            "marks_profile_id": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "generated_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "enum": ["manual", "engine", "duplicate", "duplex_copy", "ai"]
            },
            "engine": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "operation_id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "source_slot_id": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "imposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "settings", "last_result"],
      "properties": {
        "engine": {
          "enum": ["manual", "repeat", "nesting", "hybrid"]
        },
        "engine_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "horizontal_gap_mm",
            "vertical_gap_mm",
            "exact_quantity",
            "fill_remaining_space",
            "respect_priority",
            "respect_preferred_zones"
          ],
          "properties": {
            "horizontal_gap_mm": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "vertical_gap_mm": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "exact_quantity": {
              "type": "boolean"
            },
            "fill_remaining_space": {
              "type": "boolean"
            },
            "respect_priority": {
              "type": "boolean"
            },
            "respect_preferred_zones": {
              "type": "boolean"
            }
          }
        },
        "last_result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/impositionResult"
            }
          ]
        }
      }
    },
    "impositionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status",
        "requested",
        "placed",
        "unplaced",
        "overproduced",
        "generated_at",
        "warnings"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": ["complete", "incomplete", "failed"]
        },
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "placed": {
          "type": "integer",
          "minimum": 0
        },
        "unplaced": {
          "type": "integer",
          "minimum": 0
        },
        "overproduced": {
          "type": "integer",
          "minimum": 0
        },
        "generated_at": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "marksProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "crop_marks", "registration_marks", "technical_text", "color_bar"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "crop_marks": {
          "type": "boolean"
        },
        "registration_marks": {
          "type": "boolean"
        },
        "technical_text": {
          "type": "boolean"
        },
        "color_bar": {
          "type": "boolean"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "render_mode",
        "dpi",
        "faces",
        "marks_profiles",
        "default_marks_profile_id",
        "bleed_policy",
        "crop_to_content",
        "preserve_vector_content"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "render_mode": {
          "enum": ["raster", "vector_hybrid"]
        },
        "dpi": {
          "type": "integer",
          "minimum": 1
        },
        "faces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["front", "back", "combine_in_single_pdf", "order"],
          "properties": {
            "front": {
              "type": "boolean"
            },
            "back": {
              "type": "boolean"
            },
            "combine_in_single_pdf": {
              "type": "boolean"
            },
            "order": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["front", "back"]
              }
            }
          }
        },
        "marks_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/marksProfile"
          }
        },
        "default_marks_profile_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "bleed_policy": {
          "const": "slot_geometry"
        },
        "crop_to_content": {
          "type": "boolean"
        },
        "preserve_vector_content": {
          "type": "boolean"
        }
      }
    },
    "ctp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "face",
        "gripper",
        "plate",
        "color_bar",
        "technical_text",
        "registration_marks"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "face": {
          "enum": ["front", "back"]
        },
        "gripper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["edge", "depth_mm"],
          "properties": {
            "edge": {
              "enum": ["top", "right", "bottom", "left"]
            },
            "depth_mm": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        },
        "plate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offset_x_mm", "offset_y_mm"],
          "properties": {
            "offset_x_mm": {
              "$ref": "#/$defs/finiteNumber"
            },
            "offset_y_mm": {
              "$ref": "#/$defs/finiteNumber"
            }
          }
        },
        "color_bar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "height_mm", "position"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "height_mm": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "position": {
              "enum": ["opposite_gripper", "gripper", "top", "right", "bottom", "left"]
            }
          }
        },
        "technical_text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "job_name", "date", "plate_name"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "job_name": {
              "type": "boolean"
            },
            "date": {
              "type": "boolean"
            },
            "plate_name": {
              "type": "boolean"
            }
          }
        },
        "registration_marks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
